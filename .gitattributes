* text=auto

# Preserve the selected archive and extracted upstream bytes without Git filters
# or text, line-ending, keyword, or working-tree encoding conversions.
/archive/** binary -filter -ident -working-tree-encoding
/upstream/nec2c-1.3.1/** binary -filter -ident -working-tree-encoding

# Repository-authored manifests use ordinary text handling.
/.gitattributes text
/manifests/** text

# Keep A2 project-authored evidence hashes stable across Windows clones.
/build-support/** text eol=lf
/docs/** text eol=lf
/manifests/windows-x64-unmodified-build-v1.json text eol=lf
/manifests/windows-x64-mingw-ucrt64-unmodified-build-v1.json text eol=lf
/tests/** text eol=lf
/tools/verify_preservation.py text eol=lf
/verify-preservation.ps1 text eol=lf

# Keep the maintained source and its deterministic reconstruction patch stable.
/src/nec2c/** text eol=lf
/src/nec2c/somnec.c binary !eol -filter -ident -working-tree-encoding
/patches/maintained/** text eol=lf

# Maintained source and literal reconstruction patches preserve authenticated
# historical formatting. Their manifests and byte-reconstruction checks are
# authoritative; ordinary project files retain normal whitespace checks.
/src/nec2c/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
/patches/maintained/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
